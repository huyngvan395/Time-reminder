<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_alarm_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/alarm_pill_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Alarm"
        android:src="@drawable/ic_alarm_clock_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alarm_pill_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_pill_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ChronoGlass"
            android:textColor="#B8CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/alarm_pill_snooze"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_snooze_circle"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Snooze"
            android:src="@drawable/ic_snooze_zz" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/alarm_pill_stop"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_stop_circle"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Stop"
            android:src="@drawable/ic_stop_square" />
    </FrameLayout>
</LinearLayout>
